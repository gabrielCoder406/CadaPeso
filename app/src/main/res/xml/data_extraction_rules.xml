<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: el backup automático de Google solo copia la base de datos y las preferencias.
     El modelo Gemma 2 (2,6 GB) queda afuera: superaría el límite de 25 MB y el backup fallaría. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Cuentas conectadas: cifradas con una clave del Keystore que no viaja a otro teléfono. -->
        <exclude domain="sharedpref" path="cofre.xml" />
        <exclude domain="sharedpref" path="integraciones.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="cofre.xml" />
        <exclude domain="sharedpref" path="integraciones.xml" />
    </device-transfer>
</data-extraction-rules>
