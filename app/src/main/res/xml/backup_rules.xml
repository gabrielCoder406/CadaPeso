<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 a 11: mismas reglas que data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <!-- Cuentas conectadas: el token y las claves están cifrados con una clave del Keystore que no
         existe en otro teléfono; ahí se vuelve a conectar. -->
    <exclude domain="sharedpref" path="cofre.xml" />
    <exclude domain="sharedpref" path="integraciones.xml" />
</full-backup-content>
