# Copiá este archivo como .env y completalo. NUNCA subas el .env a git.

# ---- Servidor -----------------------------------------------------------------
PUERTO=8080
# Dirección pública HTTPS del servidor (Mercado Pago solo redirige y notifica a HTTPS).
URL_PUBLICA=https://cadapeso.tudominio.com
# Clave AES-256 para cifrar tokens y movimientos en la base. Generala UNA vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la perdés, los tokens guardados no se pueden leer (habría que volver a vincular).
CLAVE_CIFRADO=
# Frase que pide la app para registrar un teléfono (cualquiera que la sepa puede registrarse).
CLAVE_REGISTRO=
RUTA_BD=./datos/cadapeso.db
# 1 si el servidor está detrás de un proxy (Render, Railway, Fly, Nginx).
CONFIAR_EN_PROXY=1
SINCRONIZAR_CADA_MIN=60
RETENCION_DIAS=30
DIAS_HISTORIAL_INICIAL=90

# ---- Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app) ----------
# Credenciales de PRODUCCIÓN de tu aplicación.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta que muestra el panel al configurar Webhooks (evento "Pagos").
MP_WEBHOOK_SECRET=
# 1 = OAuth con PKCE (activalo también en "Editar aplicación" del panel). 0 = sin PKCE.
MP_PKCE=1

# ---- Banco Galicia vía Prometeo (https://prometeoapi.com) ------------------------
PROMETEO_API_KEY=
# Producción: https://banking.prometeoapi.net   Pruebas: https://banking.sandbox.prometeoapi.com
PROMETEO_URL=https://banking.prometeoapi.net
# Código del banco en Prometeo. Vacío = se busca solo (Argentina + "Galicia").
PROMETEO_PROVEEDOR=
